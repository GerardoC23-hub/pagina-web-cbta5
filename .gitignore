Thumbs.db

# Las imágenes y archivos que se suben desde el panel (uploads/) SÍ se guardan en el repositorio,
# para que todo el equipo vea las mismas imágenes. storage/ es privado y no se sube.
storage/**/*.*
!storage/**/.gitkeep
!storage/.htaccess

# Credenciales de la base de datos (cada quien copia config/conexion.example.php)
config/conexion.php

# Cuenta de correo para recuperar contraseñas (cada quien copia config/correo.example.php)
config/correo.php
